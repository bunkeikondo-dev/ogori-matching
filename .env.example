# ---- Supabase: Database (Prisma用) ----
# Supabaseダッシュボード > Settings > Database > Connection string から取得
# 実行時クエリ: Transaction Pooler (6543) を使用（サーバーレスからの多重接続に対応）
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# マイグレーション用: 直接接続 (5432)。Vercelのビルド環境からも到達できる必要があります
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ---- Supabase: Realtime / API ----
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
# サーバー専用（ブラウザに絶対に露出させないこと）。Realtime配信とレート制限に使用
SUPABASE_SERVICE_ROLE_KEY="ey..."

# ---- 管理画面 ----
# 岐阜用・東京用・部内用で共通の1つのパスコードを使う
ADMIN_PASSCODE=1234
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=true

# ---- Vercel Cron 保護 ----
# Vercelプロジェクトの環境変数に自分で設定する（16文字以上のランダム文字列推奨）。
# Vercelがcron実行時にAuthorization: Bearer <値> として自動送信します。
CRON_SECRET=change-me-to-a-long-random-string

# ---- 拠点の利用可否 ----
# 利用可能な拠点だけをカンマ区切りで指定する（例: 岐阜用のみなら ENABLED_SITES=gifu）。
# 未設定の場合は全拠点（gifu,tokyo,naibu）が有効。値を変えたら必ずVercelで再デプロイすること。
ENABLED_SITES=gifu,tokyo,naibu

# ---- 受付設定（日本時間・分単位で指定） ----
OPEN_TIME=09:30
CLOSE_TIME=09:45
BUSINESS_DAYS=1,2,3,4,5
# 待機タイムアウト秒数（既定: 900秒 = 15分）
WAIT_SECONDS=900
IGNORE_BUSINESS_HOURS=false

SEED_FORCE=false
